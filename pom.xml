<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.springbyexample</groupId>
    <artifactId>spring-by-example</artifactId>
    <version>1.0-SNAPSHOT</version>

    <packaging>pom</packaging>

    <name>Spring by Example</name>
    <description>
        Learn Spring Framework through small runnable examples
    </description>

    <modules>
        <!--    01 fundamentals        -->
        <module>01-fundamentals/hello-bean</module>
        <module>01-fundamentals/dependency-injection</module>
        <module>01-fundamentals/constructor-injection</module>
        <module>01-fundamentals/setter-injection</module>
        <module>01-fundamentals/field-injection</module>
        <module>01-fundamentals/choosing-injection-strategy</module>

        <!--    02 bean scopes         -->
        <module>02-bean-scopes/overview</module>
        <module>02-bean-scopes/singleton-scope</module>
        <module>02-bean-scopes/prototype-scope</module>

        <!--    03 Configuration         -->
        <module>03-configuration/configuration</module>
        <module>03-configuration/bean</module>
        <module>03-configuration/component</module>
        <module>03-configuration/service</module>
        <module>03-configuration/repository</module>
        <module>03-configuration/controller</module>
        <module>03-configuration/component-scan</module>
        <module>03-configuration/import-config</module>
        <module>03-configuration/import-resource</module>
        <module>03-configuration/xml-config</module>
        <module>03-configuration/java-config</module>
        <module>03-configuration/mixed-config</module>

        <!--    04 Dependency Injection   -->
        <module>04-dependency-injection/primary</module>
        <module>04-dependency-injection/qualifier</module>
        <module>04-dependency-injection/collection-injection</module>
        <module>04-dependency-injection/order</module>
        <module>04-dependency-injection/map-injection</module>
        <module>04-dependency-injection/object-provider</module>
        <module>04-dependency-injection/optional-dependencies</module>
        <module>04-dependency-injection/circular-dependencies</module>
        <module>04-dependency-injection/bean-aliases</module>

        <!--    05 Bean Lifecycle         -->
        <module>05-bean-lifecycle/initializing-bean</module>
        <module>05-bean-lifecycle/disposable-bean</module>
        <module>05-bean-lifecycle/post-construct</module>
        <module>05-bean-lifecycle/pre-destroy</module>
        <module>05-bean-lifecycle/bean-post-processor</module>
        <module>05-bean-lifecycle/bean-factory-post-processor</module>
        <module>05-bean-lifecycle/smart-lifecycle</module>

        <!--    06 Spring Events         -->
        <module>06-spring-events/publishing-events</module>
        <module>06-spring-events/listening-for-events</module>
        <module>06-spring-events/custom-events</module>
        <module>06-spring-events/transactional-events</module>
        <module>06-spring-events/async-events</module>

        <!--    07 Spring AOP            -->
        <module>07-spring-aop/what-is-aop</module>
        <module>07-spring-aop/jdk-dynamic-proxy</module>
        <module>07-spring-aop/cglib-proxy</module>
        <module>07-spring-aop/creating-an-aspect</module>
        <module>07-spring-aop/before-advice</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring.version>6.2.8</spring.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

</project>